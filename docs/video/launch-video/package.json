{
  "name": "iskolar-ng-bayan-launch-video",
  "private": true,
  "description": "IskoMatic videos (Remotion): 25-second vertical launch video and the landscape expo cut with real system footage",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render LaunchVideo out/iskomatic-launch.mp4",
    "typecheck": "tsc",
    "audio": "python scripts/make_audio.py all",
    "footage": "python scripts/record_footage.py",
    "render:expo": "remotion render ExpoVideo out/iskomatic-expo.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
